# Node.js 应用配置
PORT=3000
NODE_ENV=production

# PostgreSQL 数据库配置
DB_HOST=db
DB_PORT=5432
DB_NAME=pii_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

BACKUP_ENCRYPTION_PASSWORD=your_backup_password_here
PII_ENCRYPTION_KEYS=v1:your_backup_password_here
ACTIVE_ENCRYPTION_KEY_VERSION=v1

PII_BLIND_INDEX_SALTS=v1:your_backup_password_here
ACTIVE_BLIND_INDEX_SALT_VERSION=v1
