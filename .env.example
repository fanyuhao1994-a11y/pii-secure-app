# Node.js 应用配置
PORT=3000
NODE_ENV=production

# PostgreSQL 数据库配置（Docker Compose 内网默认主机名为 db）
DB_HOST=db
DB_PORT=5432
DB_NAME=pii_secure_db
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here
DATABASE_URL=postgresql://postgres:your_strong_db_password_here@db:5432/pii_secure_db

# 多版本密钥环配置（请使用 openssl rand -hex 32 生成 64 位十六进制密钥）
PII_ENCRYPTION_KEYS=v1:<replace_with_64_char_hex_key>
ACTIVE_ENCRYPTION_KEY_VERSION=v1

PII_BLIND_INDEX_SALTS=v1:<replace_with_64_char_hex_salt>
ACTIVE_BLIND_INDEX_SALT_VERSION=v1

# JWT 鉴权密钥 & 加密备份密码（同样建议 64 位随机字符）
JWT_SECRET=<replace_with_64_char_hex_secret>
BACKUP_ENCRYPTION_PASSWORD=<replace_with_64_char_hex_backup_password>

# 可观测性（可选，留空则不启用 Sentry 上报）
SENTRY_DSN=